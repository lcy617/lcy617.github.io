<article class="post container">
  <header class="post-header">
    <%
      // 判断是否属于「笔记」或「作品」（用 categories 区分板块）
      let section = 'notes';
      if (page.categories && page.categories.length) {
        const first = page.categories.first().name;
        if (first === 'works' || first === '作品') section = 'works';
      }
    %>
    <a href="<%- url_for('/' + section + '/') %>" class="back-link">← <%= section === 'works' ? __('nav.works') : __('nav.notes') %></a>
    <h1 class="post-title-large"><%= page.title %></h1>
    <div class="post-meta">
      <time><%= date(page.date, 'YYYY.MM.DD') %></time>
      <% if (page.updated && page.updated !== page.date) { %>
        <span class="meta-sep">·</span>
        <span><%= __('post.updated') %> <%= date(page.updated, 'YYYY.MM.DD') %></span>
      <% } %>
    </div>
  </header>

  <div class="post-content">
    <%- page.content %>
  </div>

  <footer class="post-footer">
    <nav class="post-nav">
      <% if (page.prev) { %>
        <a class="prev" href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a>
      <% } %>
      <% if (page.next) { %>
        <a class="next" href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a>
      <% } %>
    </nav>
  </footer>
</article>
