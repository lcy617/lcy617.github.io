<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

  <%
    // 确定 canonical URL（去掉 /index.html 和语言前缀的冗余）
    const canonical = (config.url + page.canonical_path).replace(/\/+$/, '') || config.url;
  %>
  <title><%- (page.title ? page.title + ' · ' : '') + config.title %></title>
  <meta name="description" content="<%= page.description || config.description %>">
  <meta name="author" content="<%= config.author %>">
  <link rel="canonical" href="<%= canonical %>">

  <%# RSS %>
  <%- feed_tag(config.url + '/atom.xml', { type: 'atom', title: config.title }) %>

  <%# Favicon（暂用 SVG 内联占位，之后可替换） %>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23222'/><text x='16' y='22' font-size='18' fill='%236db5a4' text-anchor='middle' font-family='serif'>L</text></svg>">

  <%# 关键首屏样式 inline：让背景色/布局立即渲染，不等外部 CSS（减少白屏） %>
  <style>
    html,body{margin:0;background:#1a1814;color:#e8e2d5;}
    body{font-family:Georgia,"Times New Roman",serif;font-size:16px;line-height:1.75;}
    .hero{min-height:50vh;display:flex;align-items:center;}
    .lattice-canvas{position:absolute;inset:0;}
  </style>

  <%# DNS 预热：让浏览器提前解析字体服务器，减少首次白屏 %>
  <link rel="dns-prefetch" href="//fonts.googleapis.com">
  <link rel="dns-prefetch" href="//fonts.gstatic.com">

  <%# 字体：异步加载（不阻塞渲染），精简字重降低下载量 %>
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=JetBrains+Mono:wght@400&family=Noto+Serif+SC:wght@400;500&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=JetBrains+Mono:wght@400&family=Noto+Serif+SC:wght@400;500&display=swap"></noscript>

  <%# 样式：preload 让浏览器尽早并行下载，减少白屏 %>
  <%# css() 会输出 <link rel="stylesheet">，本身是渲染阻塞的，配合上面的 inline critical CSS 可保证首屏不白 %>
  <%- css('css/style') %>

  <%# Hexo 自带变量，供前端 JS 使用 %>
  <script>
    window.__LITHOS__ = {
      root: '<%= config.root %>',
      lang: '<%= page.lang || "zh" %>'
    };
  </script>

  <%# 3D 晶体粒子：仅在首页加载 Three.js import map（CDN，带版本号，避开 /js/* 的 immutable 缓存） %>
  <%
    let _isHome = (typeof is_home === 'function' && is_home()) || page.layout === 'index' || page.layout === 'index-en';
    let _crystalOn = theme.crystal && theme.crystal.enabled !== false;
  %>
  <% if (_isHome && _crystalOn) { %>
    <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
        "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
      }
    }
    </script>
  <% } %>
</head>
