<%# —— 第 6 节：研究展望 —— %>
<section class="story-section" id="research" data-section="5" data-morph="3">
  <div class="story-panel">
    <div class="section-head">
      <h2 class="section-title"><%= __('nav.research') %></h2>
    </div>
    <% if (researchPage) { %>
      <div class="story-content"><%- researchPage.content %></div>
    <% } %>
  </div>
</section>
